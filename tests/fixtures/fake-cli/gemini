#!/usr/bin/env bash
# 假 gemini（--output-format stream-json）：result 事件带 stats
echo "{\"type\":\"args\",\"argv\":\"$*\"}"
echo "{\"type\":\"stdin\",\"text\":\"$(cat | tr '\n"' '  ')\"}"
echo '{"type":"init","session_id":"s1","model":"m"}'
[ "${FAKE_NO_USAGE:-0}" = 1 ] || echo '{"type":"result","status":"success","stats":{"total_tokens":1300,"input_tokens":1200,"output_tokens":100,"cached":800,"input":400,"duration_ms":10,"tool_calls":0,"models":{}}}'
sleep "${FAKE_SLEEP:-1}"
exit "${FAKE_EXIT:-0}"
