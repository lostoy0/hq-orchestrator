#!/usr/bin/env bash
echo "{\"type\":\"args\",\"argv\":\"$*\"}"
cat >/dev/null
echo '{"type":"system","subtype":"init"}'
[ "${FAKE_NO_USAGE:-0}" = 1 ] || echo '{"type":"result","subtype":"success","total_cost_usd":0.25,"usage":{"input_tokens":100,"output_tokens":20,"cache_creation_input_tokens":30,"cache_read_input_tokens":5000}}'
sleep "${FAKE_SLEEP:-1}"
