#!/usr/bin/env bash
# 假 codex：打印参数与 stdin，输出按 codex-cli 0.172.0 实测格式模拟的 JSON 事件。
# FAKE_EXIT 控制退出码，FAKE_NO_USAGE=1 不输出 usage，FAKE_SLEEP 控制时长，FAKE_WRITE=<文件> 在当前目录写一个文件（模拟改动）。
echo "{\"type\":\"args\",\"argv\":\"$*\"}"
echo "{\"type\":\"stdin\",\"text\":\"$(cat | tr '\n"' '  ')\"}"
echo '{"type":"thread.started","thread_id":"00000000-0000-0000-0000-000000000000"}'
echo '{"type":"item.completed","item":{"id":"item_0","type":"error","message":"Under-development features enabled: x."}}'
echo '{"type":"turn.started"}'
[ -n "${FAKE_WRITE:-}" ] && echo "fake" > "$FAKE_WRITE"
echo '{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"done"}}'
[ "${FAKE_NO_USAGE:-0}" = 1 ] || echo '{"type":"turn.completed","usage":{"input_tokens":1000,"cached_input_tokens":400,"cache_write_input_tokens":0,"output_tokens":50,"reasoning_output_tokens":20}}'
sleep "${FAKE_SLEEP:-1}"
exit "${FAKE_EXIT:-0}"
